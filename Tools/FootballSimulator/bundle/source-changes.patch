+using System.Collections;
+using System.Collections.Generic;
+using System.Linq;
+using UnityEngine;
+
+namespace FStudio.Utilities {
+    public class DontDestroy : MonoBehaviour {
+        [SerializeField] private string destroyGroup = "football";
+
+        private static readonly Dictionary<string, HashSet<GameObject>> trackedObjects =
+            new Dictionary<string, HashSet<GameObject>>();
+
+        void Awake () {
+            Register(gameObject, destroyGroup);
+            DontDestroyOnLoad(gameObject); 
+        }
+
+        public static void Register(GameObject target, string destroyGroup = "football") {
+            if (target == null) {
+                return;
+            }
+
+            if (!trackedObjects.TryGetValue(destroyGroup, out var bucket)) {
+                bucket = new HashSet<GameObject>();
+                trackedObjects[destroyGroup] = bucket;
+            }
+
+            bucket.Add(target);
+        }
+
+        public static void DestroyTracked(string destroyGroup = "football") {
+            if (!trackedObjects.TryGetValue(destroyGroup, out var bucket)) {
+                return;
+            }
+
+            foreach (var target in bucket.Where(target => target != null).ToList()) {
+                Object.Destroy(target);
+            }
+
+            trackedObjects.Remove(destroyGroup);
+        }
+    }
+
+}
